{
  "$metadata": {
    "tokenSetOrder": [
      "global",
      "brand-primitive",
      "semantic-ocrevus"
    ]
  },
  "semantic-ocrevus": {
    "typography": {
      "font": {
        "display": {
          "$type": "string",
          "$value": "{typography.font-family.headings.brutalist}"
        },
        "heading": {
          "$type": "string",
          "$value": "{typography.font-family.headings.industrial}"
        },
        "body": {
          "$type": "string",
          "$value": "{typography.font-family.body.body}"
        }
      },
      "weight": {
        "display": {
          "$type": "string",
          "$value": "{typography.weight.regular}"
        },
        "heading": {
          "$type": "string",
          "$value": "{typography.weight.bold}"
        },
        "body": {
          "$type": "string",
          "$value": "{typography.weight.regular}"
        }
      }
    },
    "surface": {
      "bg": {
        "primary-darker": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.500}"
        },
        "primary-dark": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.400}"
        },
        "primary": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.300}"
        },
        "primary-light": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.200}"
        },
        "primary-lighter": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{colors.ocrevus.accent.base}"
        }
      },
      "storke": {
        "primary-darker": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.500}"
        },
        "primary-dark": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.400}"
        },
        "primary": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.300}"
        },
        "primary-light": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.200}"
        },
        "primary-lighter": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.100}"
        },
        "accent": {
          "$type": "color",
          "$value": "{colors.ocrevus.accent.base}"
        }
      }
    },
    "color": {
      "display": {
        "light": {
          "$type": "color",
          "$value": "{color.functional.white}"
        },
        "dark": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.300}"
        }
      },
      "heading": {
        "light": {
          "$type": "color",
          "$value": "{color.functional.white}"
        },
        "dark": {
          "$type": "color",
          "$value": "{colors.ocrevus.primary.300}"
        }
      },
      "body": {
        "light": {
          "$type": "color",
          "$value": "{color.functional.white}"
        },
        "dark": {
          "$type": "color",
          "$value": "{color.neutral.900}"
        }
      },
      "button-text": {
        "dark": {
          "$type": "color",
          "$value": "{color.neutral.900}"
        },
        "light": {
          "$type": "color",
          "$value": "{color.neutral.900}"
        }
      },
      "link-cta": {
        "dark": {
          "$type": "color",
          "$value": "{color.functional.white}"
        },
        "light": {
          "$type": "color",
          "$value": "{color.neutral.900}"
        }
      }
    }
  }
}
